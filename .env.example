# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (Anthropic), used for answer generation ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (hosted API), used for BOTH documents and queries ---
# Two keys are needed: one for generation above, one for embeddings here.
# EMBEDDING_API_KEY is read first; OPENAI_API_KEY is accepted as a fallback name.
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small supports a `dimensions` parameter, so its output is reduced to
# 384 to match the existing vector(384) column. Changing this REQUIRES altering that
# column and re-embedding the whole corpus -- it is not a drop-in change.
EMBEDDING_DIMENSIONS=384

# --- Postgres ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=compliance_copilot
# Host port for Postgres. Only affects access from your machine -- the backend always
# reaches the database at db:5432 inside the compose network. Uncomment and change if
# you already run Postgres on 5432 locally, or `docker compose up` will fail to bind.
# POSTGRES_HOST_PORT=5433

# --- Retrieval ---
TOP_K=5
# Cosine similarity threshold below which we don't trust a chunk enough to use it
MIN_SIMILARITY=0.25
# How closely a citation's excerpt must match the retrieved text to be shown (0-1)
CITATION_MIN_MATCH=0.7
# Similarity at or above which retrieval evidence can support "high"/"medium"
# confidence. These cap the model's self-reported confidence; they never raise it.
CONFIDENCE_HIGH_SIMILARITY=0.55
CONFIDENCE_MEDIUM_SIMILARITY=0.40

# --- Cost logging ---
# Claude Haiku 4.5 list pricing, USD per million tokens. Used to attach an indicative
# cost to each logged query; update if pricing changes.
PRICE_PER_MTOK_INPUT=1.00
PRICE_PER_MTOK_OUTPUT=5.00

# --- Local (non-Docker) runs only ---
# In Docker the docs are mounted at /app/docs, which is the default. Set this when
# running the backend directly from a checkout, or ingestion will find no files.
# DOCS_DIR=./docs
